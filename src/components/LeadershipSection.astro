---
/**
 * One organization, in three bands: title, body (copy + photo, sides
 * alternating), and impact stats.
 */
import RichText from './RichText.astro';
import type { Leadership } from '../data/portfolio';
import { parseStat } from '../lib/stats';

interface Props {
  entry: Leadership;
  index: number;
}

const { entry, index } = Astro.props;

const label = String(index + 1).padStart(2, '0');
/** Even entries read copy-then-photo; odd entries flip. */
const flipped = index % 2 === 1;
const stats = entry.stats.map((stat) => ({ ...stat, ...parseStat(stat.num) }));
---

<section class:list={['org', { 'is-flipped': flipped }]} data-reveal>
  <!-- Title band -->
  <div class="band title-band">
    <div class="num idx">{label}</div>
    <div class="title-row">
      <div>
        <h2 class="d-title role">{entry.role}</h2>
        <div class="org-row">
          <img class="logo" src={entry.logo} alt="" loading="lazy" decoding="async" />
          <span class="org-name">{entry.organization}</span>
        </div>
      </div>
      <span class="date">{entry.date}</span>
    </div>
  </div>

  <!-- Body band -->
  <div class="band body-band">
    <div class="gutter"></div>

    <div class="copy-col">
      {
        entry.description.map((paragraph) => (
          <p class="copy">
            <RichText text={paragraph} />
          </p>
        ))
      }
    </div>

    <figure class="photo-col">
      <div class="frame" data-parallax>
        <img src={entry.groupImage} alt={entry.imageCaption} loading="lazy" decoding="async" />
      </div>
      <figcaption class="caption">{entry.imageCaption}</figcaption>
    </figure>
  </div>

  <!-- Impact band -->
  <div class="band impact-band">
    <div class="label-xs impact-label">Impact</div>
    <div class="stat-grid">
      {
        stats.map((stat) => (
          <div class="stat-cell">
            <div
              class="num figure"
              data-count-target={stat.target ?? undefined}
              data-count-prefix={stat.prefix}
              data-count-suffix={stat.suffix}
            >
              {stat.num}
            </div>
            <div class="stat-caption">{stat.subtext}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .org {
    padding: 64px 0;
    border-top: 1px solid var(--rule);
    transform: translateY(30px);
  }

  .org.is-revealed {
    transform: none;
  }

  /* --- Bands -------------------------------------------------------------- */

  .title-band {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 36px;
    margin-bottom: 40px;
  }

  .idx {
    font-size: 15px;
    letter-spacing: .08em;
    color: var(--ink-5);
    padding-top: 12px;
  }

  .title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .role {
    font-size: clamp(36px, 4.6vw, 68px);
    line-height: 1.14;
    margin: 0 0 14px;
  }

  .org-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo {
    width: 22px;
    height: 22px;
    object-fit: contain;
    opacity: .9;
    flex: none;
  }

  .org-name {
    font-size: 16px;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .date {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-5);
  }

  /* --- Body band ---------------------------------------------------------- */

  .body-band {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) minmax(0, 1fr);
    gap: 44px;
    align-items: start;
  }

  .copy-col {
    display: flex;
    flex-direction: column;
    gap: 22px;
    order: 1;
  }

  .photo-col {
    margin: 0;
    order: 2;
  }

  .org.is-flipped .copy-col { order: 2; }
  .org.is-flipped .photo-col { order: 1; }

  .frame {
    overflow: hidden;
    border: 1px solid rgba(239, 235, 228, .14);
    border-radius: var(--radius-card);
    height: 420px;
    position: relative;
    background: var(--surface-2);
  }

  /* Oversized so the scroll-driven drift never exposes an edge. */
  .frame img {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 110%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  .caption {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink-5);
    font-style: italic;
    margin-top: 14px;
  }

  /* --- Impact band -------------------------------------------------------- */

  .impact-band {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 36px;
    margin-top: 56px;
  }

  .impact-label {
    letter-spacing: .16em;
    padding-top: 8px;
  }

  /* `gap: 1px` over the rule colour renders the gutters as hairlines. */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    margin-left: -24px;
  }

  .stat-cell {
    padding: 26px 28px 22px 24px;
    background: var(--bg);
  }

  .figure {
    font-size: clamp(40px, 4.6vw, 68px);
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .stat-caption {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-top: 12px;
    max-width: 22ch;
  }

  /* --- Narrow viewports --------------------------------------------------- */

  @media (max-width: 900px) {
    .org {
      padding: 44px 0;
    }

    .title-band,
    .impact-band {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .idx,
    .impact-label {
      padding-top: 0;
    }

    .body-band {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .gutter {
      display: none;
    }

    /* Copy always leads once the bands are stacked. */
    .copy-col,
    .photo-col,
    .org.is-flipped .copy-col,
    .org.is-flipped .photo-col {
      order: 0;
    }

    .frame {
      height: 300px;
    }

    .stat-grid {
      margin-left: 0;
    }

    .stat-cell {
      padding: 20px 18px;
    }
  }

  @media (max-width: 560px) {
    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
