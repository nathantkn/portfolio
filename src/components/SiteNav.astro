---
/**
 * The one nav shared by every page. It is fixed and transparent — it floats
 * over page content, so heroes can run full-bleed underneath it. Pages that
 * shouldn't sit under it offset their first section by `--nav-h`.
 */
interface Props {
  /** Which link renders as the current page. */
  active: 'about' | 'projects' | 'experience' | 'leadership';
}

const { active } = Astro.props;

const links = [
  { id: 'about', label: 'about', href: '/' },
  { id: 'projects', label: 'projects', href: '/projects' },
  { id: 'experience', label: 'experience', href: '/experience' },
  { id: 'leadership', label: 'leadership', href: '/leadership' },
] as const;
---

<nav class="site-nav">
  <a class="wordmark" href="/">Nathan Trinh</a>

  <!-- Only rendered (visible) under the mobile breakpoint; toggles `.links`. -->
  <button
    class="nav-toggle"
    type="button"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="site-nav-links"
  >
    <span class="bars" aria-hidden="true"></span>
  </button>

  <div class="links" id="site-nav-links">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { 'is-active': link.id === active }]}
          aria-current={link.id === active ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 32px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink);
    text-decoration: none;
    /* Keeps the name readable where it crosses imagery. */
    text-shadow: 0 2px 12px rgba(0, 0, 0, .6);
  }

  /* The pill is the only surface in the nav — it carries its own backdrop. */
  .links {
    display: flex;
    gap: 8px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: rgba(11, 11, 12, .55);
    backdrop-filter: blur(12px);
    border: 1px solid var(--rule);
  }

  /* Same face as the hero CTAs, one weight lighter — the uppercase and the
     tight tracking already make 12px read denser than the 14px CTA text. */
  .nav-link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: .08em;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    color: var(--ink-4);
    text-decoration: none;
    transition: color .2s ease, background .2s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    background: rgba(var(--ink-rgb), .08);
  }

  .nav-link.is-active {
    color: var(--bg);
    background: var(--ink);
  }

  /* Hamburger — hidden above the mobile breakpoint. Borrows the pill's
     backdrop so it reads as part of the same floating surface. */
  .nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: rgba(11, 11, 12, .55);
    backdrop-filter: blur(12px);
    border: 1px solid var(--rule);
    color: var(--ink);
    cursor: pointer;
  }

  /* Three bars: the middle one is the element, the outer two are its
     pseudo-elements, so the open state can collapse them into an X. */
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 17px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform .25s var(--ease-out-soft), opacity .2s ease;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before { top: -5.5px; }
  .bars::after { top: 5.5px; }

  .site-nav.is-open .bars {
    transform: rotate(45deg);
  }

  .site-nav.is-open .bars::before {
    transform: translateY(5.5px) rotate(-90deg);
  }

  .site-nav.is-open .bars::after {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .site-nav {
      padding: 16px 20px;
    }

    .nav-toggle {
      display: flex;
    }

    /* The pill becomes a dropdown panel anchored under the nav bar. */
    .links {
      position: absolute;
      top: calc(100% - 6px);
      right: 20px;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 6px;
      min-width: 168px;
      border-radius: 16px;
      opacity: 0;
      transform: translateY(-6px);
      /* `visibility` keeps the closed panel's links out of the tab order. */
      visibility: hidden;
      transition: opacity .2s ease, transform .25s var(--ease-out-soft),
        visibility .2s;
    }

    .site-nav.is-open .links {
      opacity: 1;
      transform: none;
      visibility: visible;
    }

    .nav-link {
      font-size: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links,
    .bars,
    .bars::before,
    .bars::after {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav-toggle');

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!nav.classList.contains('is-open'));
    });

    // Tapping anywhere off the nav dismisses it.
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !nav.classList.contains('is-open')) return;
      setOpen(false);
      toggle.focus();
    });

    // Resizing past the breakpoint hands layout back to the desktop pill.
    const wide = window.matchMedia('(min-width: 641px)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
