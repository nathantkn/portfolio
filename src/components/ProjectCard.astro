---
/**
 * One bento card. Scale is driven entirely by `data-tier` on the slot, so the
 * client-side filter re-flow only has to rewrite that attribute and `--span`.
 * Every tag is rendered; CSS hides the ones the tier doesn't show.
 */
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  /** Index within the unfiltered list — drives the fallback badge. */
  index: number;
  tier: number;
  span: number;
}

const { project, index, tier, span } = Astro.props;

const badge = project.badge || String(index + 1).padStart(2, '0');
---

<div
  class="card-slot"
  data-card
  data-tier={tier}
  data-index={index}
  data-badge={badge}
  data-kind={project.kind}
  data-reveal
  style={`--span: ${span};`}
>
  <button class="card" type="button" data-open aria-label={`Open details for ${project.title}`}>
    <span class="glow" aria-hidden="true"></span>

    <span class="media">
      <img src={project.img} alt={project.title} loading="lazy" decoding="async" />
      <span class="scrim" aria-hidden="true"></span>
      <span class="badge" data-badge-text>{badge}</span>
    </span>

    <span class="body">
      <span class="head">
        <span class="d-title title">{project.title}</span>
      </span>
      <span class="blurb">{project.blurb}</span>
      <span class="chips">
        {project.tags.map((tag) => <span class="chip">{tag}</span>)}
      </span>
    </span>
  </button>
</div>

<style>
  /* --- Per-tier scale ---------------------------------------------------- */

  .card-slot {
    grid-column: span var(--span);
    transform: translateY(30px);
  }

  .card-slot.is-revealed {
    transform: none;
  }

  .card-slot[data-tier='0'] { --card-min-h: 520px; --card-title: 38px; }
  .card-slot[data-tier='1'] { --card-min-h: 470px; --card-title: 32px; }
  .card-slot[data-tier='2'] { --card-min-h: 430px; --card-title: 28px; }
  .card-slot[data-tier='3'] { --card-min-h: 390px; --card-title: 24px; }
  .card-slot[data-tier='4'] { --card-min-h: 360px; --card-title: 22px; }

  /* Tag counts per tier: 6 / 5 / 4 / 3 / 3. */
  .card-slot[data-tier='0'] .chip:nth-child(n + 7),
  .card-slot[data-tier='1'] .chip:nth-child(n + 6),
  .card-slot[data-tier='2'] .chip:nth-child(n + 5),
  .card-slot[data-tier='3'] .chip:nth-child(n + 4),
  .card-slot[data-tier='4'] .chip:nth-child(n + 4) {
    display: none;
  }

  .card-slot[hidden] {
    display: none;
  }

  /* --- Card ------------------------------------------------------------- */

  .card {
    /* Reset the button chrome — this is a card that happens to be clickable. */
    appearance: none;
    margin: 0;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    width: 100%;

    height: 100%;
    min-height: var(--card-min-h);
    position: relative;
    top: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--rule);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    /* The lift is `top`, not `transform`, on purpose. A transform here puts the
       card on its own layer, and the zoomed image inside `.media` — also
       transformed — then gets its clip resolved against the card's pre-lift
       position. The image's bottom edge leaks a 1px line over the scrim for the
       length of the transition. Offsetting with `top` keeps the ancestor
       untransformed and the clip correct; the image keeps its own transform. */
    transition: top .45s var(--ease-out-soft), border-color .3s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--cat-2);
    top: -5px;
  }

  /* Matches the hover border so keyboard focus and pointer hover read as the
     same affordance. */
  .card:focus-visible {
    outline: 2px solid var(--cat-2);
    outline-offset: 3px;
  }

  .glow {
    position: absolute;
    inset: 0;
    opacity: .13;
    background: radial-gradient(120% 90% at 50% 0%, var(--accent) 0%, transparent 62%);
  }

  /* --- Image region ------------------------------------------------------ */

  .media {
    position: relative;
    display: block;
    overflow: hidden;
    flex: 1;
    min-height: 0;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: saturate(.95);
    transition: transform .7s var(--ease-out-soft);
  }

  .card:hover .media img,
  .card:focus-visible .media img {
    transform: scale(1.05);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--surface) 2%, rgba(var(--surface-rgb), .15) 60%);
  }

  .badge {
    position: absolute;
    top: 14px;
    left: 16px;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--cat-2);
    background: rgba(11, 11, 12, .7);
    backdrop-filter: blur(6px);
    padding: 5px 10px;
    border-radius: var(--radius-pill);
  }

  /* --- Text region ------------------------------------------------------- */

  .body {
    position: relative;
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .title {
    font-size: var(--card-title);
    line-height: 1.14;
  }

  .year {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink-5);
    white-space: nowrap;
    padding-top: 4px;
  }

  .blurb {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-3);
    text-wrap: pretty;
    max-width: 62ch;
  }

  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--ink-2);
    background: rgba(var(--ink-rgb), .07);
    padding: 5px 9px;
    border-radius: var(--radius-chip);
  }

  /* --- Narrow viewports -------------------------------------------------- */

  @media (max-width: 1024px) {
    /* Collapse the cascade to at most two across. `grid-column` wins over the
       `--span` var, and the slot never carries an inline grid-column. */
    .card-slot {
      grid-column: span 6;
    }

    .card-slot[data-tier='0'] {
      grid-column: span 12;
    }
  }

  @media (max-width: 700px) {
    .card-slot {
      grid-column: span 12;
    }

    .card {
      min-height: 340px;
    }

    /* One column: give every card the same generous tag allowance. */
    .card-slot .chip:nth-child(n + 4) {
      display: none;
    }

    .card-slot .title {
      font-size: 28px;
    }
  }
</style>
