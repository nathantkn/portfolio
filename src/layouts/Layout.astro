---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import Footer from "../components/Footer.astro";

interface Props {
	/** Which nav link renders as the current page. */
	active?: 'about' | 'projects' | 'experience' | 'leadership';
}

const { active = 'about' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Nathan Trinh's Portfolio.">
		<title>Nathan Trinh's Portfolio</title>
	</head>
	<body>
		<SiteNav active={active} />
		<!-- No top offset: the About hero is meant to run full-bleed under the nav. -->
		<main>
			<slot />
		</main>
		<Footer/>
	</body>
</html>