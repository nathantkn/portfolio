---
/**
 * Shell for every page: one nav, one footer, one token set.
 */
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  active: 'about' | 'projects' | 'experience' | 'leadership';
  /** Drop the nav offset so the first section can run full-bleed under it. */
  flush?: boolean;
  /** Pages with their own footer markup opt out of the shared one. */
  footer?: boolean;
  /** Extra class on `<body>`, for pages that re-theme the shell. */
  bodyClass?: string;
}

const { title, description, active, flush = false, footer = true, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class:list={['design-page', { 'is-flush': flush }, bodyClass]}>
    <SiteNav active={active} />
    <slot />
    {footer && <SiteFooter />}

    <!--
      The home hero plays an intro on arrival but not when you hop back to it
      from another page. Rather than infer that from the referrer or the
      navigation type — both of which are unreliable this early in the
      document's life — every same-origin link click leaves a note here. The
      home page reads the note and clears it, so a plain refresh (no click
      involved) still counts as an arrival.
    -->
    <script is:inline>
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a[href]');
        if (!link || link.target === '_blank') return;
        if (new URL(link.href, location.href).origin !== location.origin) return;
        try {
          sessionStorage.setItem('internalNav', '1');
        } catch {
          /* Privacy mode — the home page just replays its intro. */
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* The nav is fixed, so it no longer occupies layout space — the first
     section of these pages would otherwise start underneath it. */
  .design-page {
    padding-top: var(--nav-h);
  }

  .design-page.is-flush {
    padding-top: 0;
  }

  /* Link colour for the redesigned pages only. `:where()` on the page class
     keeps this at element specificity so component classes still win. */
  :where(.design-page) a {
    color: var(--accent);
    text-decoration: none;
  }

  :where(.design-page) a:hover {
    color: var(--accent-hover);
  }

  /* Body scroll lock while the project detail overlay is open. */
  html.scroll-locked {
    overflow: hidden;
  }
</style>
