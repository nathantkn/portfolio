---
import DesignLayout from '../layouts/DesignLayout.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import { EXPERIENCE } from '../data/portfolio';
import {
  DOMAIN_START,
  DOMAIN_SPAN,
  DOMAIN_YEARS,
  currentMonthIndex,
  durationLabel,
  isCurrent,
  rangeOf,
} from '../lib/dates';

// "Present" and the Today marker are resolved from the clock, not hard-coded.
const nowIndex = currentMonthIndex(new Date());

const pct = (months: number) => `${((months / DOMAIN_SPAN) * 100).toFixed(2)}%`;

const roles = EXPERIENCE.map((role, i) => {
  const range = rangeOf(role.date, nowIndex);
  const months = Math.max(1, range.end - range.start);

  return {
    ...role,
    anchor: `role-${i}`,
    index: String(i + 1).padStart(2, '0'),
    current: isCurrent(role.date),
    bigYear: String(Math.floor(range.start / 12)),
    duration: durationLabel(months),
    side: (i % 2 === 0 ? 'left' : 'right') as 'left' | 'right',
    barLeft: pct(range.start - DOMAIN_START),
    barWidth: pct(range.end - range.start),
  };
});

const todayLeft = pct(nowIndex - DOMAIN_START);

const meta = [
  '3 SWE internships',
  '2 teaching assistant roles',
  '1 HCI research role',
];
---

<DesignLayout
  title="Nathan Trinh"
  description="Nathan Trinh's engineering, research and teaching roles."
  active="experience"
>
  <div class="progress" data-progress></div>

  <header class="shell hero">
    <div class="hero-row">
      <h1 class="d-h1 hero-title" data-hero>My<br /><em>work experience</em></h1>
      <div class="meta">
        {meta.map((line) => <span>{line}</span>)}
      </div>
    </div>
  </header>

  <!-- Part 1 — overlap map -->
  <section class="shell overlap">
    <div class="section-head">
      <span class="label-xs">The timeline</span>
      <span class="fill"></span>
      <span class="label-xs">Click a bar for more info</span>
    </div>

    <div class="gantt" data-reveal>
      <div class="gutters" aria-hidden="true">
        <div></div><div></div><div></div><div class="last"></div>
      </div>

      <div class="year-row" aria-hidden="true">
        {DOMAIN_YEARS.map((year) => <span class="year-label">{year}</span>)}
      </div>

      <div class="bars">
        {
          roles.map((role) => (
            <div class="bar-row">
              <button
                class:list={['bar', { 'is-current': role.current }]}
                type="button"
                data-jump={role.anchor}
                title={`${role.role} · ${role.company}`}
                style={`left: ${role.barLeft}; width: ${role.barWidth};`}
              >
                {role.role}
              </button>
            </div>
          ))
        }
      </div>

      <div class="today" style={`left: ${todayLeft};`}>
        <span class="today-label">Today</span>
      </div>
    </div>
  </section>

  <!-- Part 2 — centre-spine timeline -->
  <main class="shell timeline" data-timeline>
    <div class="spine" aria-hidden="true"></div>
    <div class="spine-fill" data-spine-fill aria-hidden="true"></div>

    {roles.map((role) => <TimelineEntry {...role} />)}
  </main>
</DesignLayout>

<style>
  /* --- Scroll progress ----------------------------------------------------- */

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--accent);
    z-index: 60;
    will-change: width;
  }

  /* --- Header -------------------------------------------------------------- */

  .hero {
    padding: 116px 40px 52px;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .hero-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(60px, 11vw, 150px);
  }

  .hero-title em {
    color: var(--accent);
  }

  .meta {
    padding-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-5);
  }

  .meta-lede {
    color: var(--ink-3);
  }

  /* --- Overlap map --------------------------------------------------------- */

  .overlap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 40px 20px;
  }

  .section-head {
    margin-bottom: 22px;
  }

  .section-head .label-xs {
    letter-spacing: .18em;
  }

  .gantt {
    position: relative;
    padding: 26px 0 8px;
    transform: translateY(20px);
    transition-duration: .7s;
  }

  .gantt.is-revealed {
    transform: none;
  }

  .gutters {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    pointer-events: none;
  }

  .gutters > div {
    border-left: 1px solid var(--rule-soft);
  }

  .gutters > .last {
    border-right: 1px solid var(--rule-soft);
  }

  .year-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 14px;
  }

  .year-label {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: .16em;
    color: var(--ink-5);
    padding-left: 10px;
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 7px;
    position: relative;
  }

  .bar-row {
    position: relative;
    height: 38px;
  }

  .bar {
    position: absolute;
    top: 0;
    height: 38px;
    transform-origin: left center;
    animation: d-bar-grow .85s var(--ease-out-soft) both;
    border: 0;
    border-radius: var(--radius-chip);
    cursor: pointer;
    background: rgba(var(--ink-rgb), .16);
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: .04em;
    text-align: left;
    padding: 0 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    transition: filter .25s ease;
  }

  .bar.is-current {
    background: var(--accent);
    color: var(--bg);
  }

  .bar:hover,
  .bar:focus-visible {
    filter: brightness(1.18);
  }

  .today {
    position: absolute;
    top: 26px;
    bottom: 8px;
    width: 1px;
    background: rgba(var(--accent-rgb), .55);
  }

  .today-label {
    position: absolute;
    top: -18px;
    left: 6px;
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  /* --- Timeline ------------------------------------------------------------ */

  .timeline {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 76px 40px 130px;
    position: relative;
  }

  .spine,
  .spine-fill {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    transform: translateX(-.5px);
  }

  .spine {
    bottom: 0;
    background: var(--rule);
  }

  .spine-fill {
    height: 0;
    background: linear-gradient(to bottom, rgba(var(--accent-rgb), .15), var(--accent));
    will-change: height;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 72px 20px 40px;
    }

    .overlap {
      padding: 0 20px 20px;
    }

    .timeline {
      padding: 48px 20px 90px;
    }

    /* The spine only makes sense while entries alternate around it. */
    .spine,
    .spine-fill {
      display: none;
    }

    .bar {
      font-size: 11px;
      padding: 0 10px;
    }
  }
</style>

<script>
  import { onScrollFrame, makeRevealSweep, parallaxHero } from '../lib/scroll';

  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const spineFill = document.querySelector<HTMLElement>('[data-spine-fill]');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];

  const heroFrame = parallaxHero(document.querySelector<HTMLElement>('[data-hero]'));
  const sweep = makeRevealSweep(0.92);

  onScrollFrame(() => {
    heroFrame();

    // Top progress bar.
    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
    }

    // Spine fill grows to the viewport midpoint, clamped to the container.
    if (timeline && spineFill) {
      const rect = timeline.getBoundingClientRect();
      const reach = window.innerHeight * 0.5 - rect.top;
      spineFill.style.height = `${Math.max(0, Math.min(rect.height, reach))}px`;
    }

    // Light each dot once its entry crosses the midpoint.
    const mid = window.innerHeight * 0.5;
    for (const entry of entries) {
      const rect = entry.getBoundingClientRect();
      const dot = entry.querySelector<HTMLElement>('[data-dot]');
      dot?.classList.toggle('is-lit', rect.top < mid && rect.bottom > 0);
    }

    sweep();
  });

  // Clicking a Gantt bar jumps to that role's card.
  for (const bar of document.querySelectorAll<HTMLElement>('[data-jump]')) {
    bar.addEventListener('click', () => {
      const target = document.getElementById(bar.dataset.jump ?? '');
      if (!target) return;
      window.scrollTo({
        top: window.scrollY + target.getBoundingClientRect().top - 120,
        behavior: 'smooth',
      });
    });
  }
</script>
