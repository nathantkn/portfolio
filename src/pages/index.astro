---
/**
 * Home / about — one dark editorial page: hero, about copy, photo strip, the
 * draggable skill cloud, and the three onward links.
 */
import DesignLayout from '../layouts/DesignLayout.astro';
import WordCloud from '../components/WordCloud.astro';
import heroBg from '../assets/new-bg.gif';

// `accent` names one of the `--cat-*` design tokens, not a literal.
const photos = [
  { span: 4, img: '/webdev_team.jpg', caption: 'Web Dev Team, SparkHacks 2026', accent: 'var(--cat-1)' },
  { span: 5, img: '/wildhacks2025.jpg', caption: 'First win, WildHacks 2025', accent: 'var(--cat-2)' },
  { span: 3, img: '/fulcrum-headshot.jpeg', caption: 'Headshot, Fulcrum Labs 2026', accent: 'var(--cat-3)' },
];

const rows = [
  {
    href: '/projects',
    label: 'Projects',
    note: 'hackathon builds, research tools, production sites',
    accent: 'var(--cat-1)',
  },
  { href: '/experience', label: 'Experience', note: 'engineering, research, teaching', accent: 'var(--cat-2)' },
  { href: '/leadership', label: 'Leadership', note: 'hackathons and student community', accent: 'var(--cat-3)' },
];
---

<DesignLayout
  title="Nathan Trinh"
  description="Nathan Trinh — CS senior at the University of Illinois Chicago."
  active="about"
  flush
  bodyClass="home"
>
  <!--
    The hero's staggered intro is an arrival flourish, not something to sit
    through on every nav click. The note in `sessionStorage` is written by the
    click handler in DesignLayout and is only ever present when the previous
    page of this site sent us here; reading it also clears it, so a refresh
    (nobody clicked anything) reads nothing and counts as an arrival.

    This runs inline, during parse and before the hero exists, so the class is
    on `<html>` by the time the animation would start — a deferred module
    script would let it flash. Opting in (the animation is off by default)
    also means no-JS visitors just see the hero.
  -->
  <script is:inline>
    (() => {
      // Storage access throws outright in some privacy modes. A visitor who
      // can't be tracked between pages should still get the intro, so a
      // failure here falls through to playing it.
      let internal = false;
      try {
        internal = sessionStorage.getItem('internalNav') === '1';
        sessionStorage.removeItem('internalNav');
      } catch {
        /* Privacy mode — treat it as an arrival. */
      }

      if (internal) return;

      document.documentElement.classList.add('play-hero-intro');
      // A refresh normally restores the old scroll position, which would run
      // the intro off-screen while the reader sits halfway down the page. If
      // we're playing it, start where it can be seen.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    })();
  </script>

  <main class="home-main">
    <!-- 1. Hero -->
    <section class="hero">
      <div class="hero-bg" data-hero-bg style={`background-image: url(${heroBg.src});`}></div>
      <div class="hero-scrim"></div>

      <div class="hero-inner" data-hero-inner>
        <h1 class="hero-name">Nathan Trinh</h1>
        <p class="hero-sub">
          Building software for <span class="hl-1">the greater good of people</span>.
        </p>
        <div class="hero-cta">
          <a class="cta cta-primary" href="/Nathan_Trinh_resume.pdf" target="_blank" rel="noopener noreferrer">
            my resume
          </a>
          <a class="cta cta-ghost" href="https://www.linkedin.com/in/khoi-nguyen-trinh/" target="_blank">get in touch</a>
        </div>
      </div>

      <span class="scroll-cue">scroll ↓</span>
    </section>

    <!-- 2. About -->
    <section class="sec">
      <div class="sec-index">01 / about</div>
      <div class="sec-body">
        <div class="about">
          <p class="about-lead" data-reveal>
            I'm Nathan, a Software Engineer recently graduated from the University of Illinois Chicago.
          </p>
          <p data-reveal>
            I'm currently working as a <span class="hl-1">Startup Associate</span> at Fulcrum GT 
            through the Startup Lab program, where I lead the production of a product at the intersection 
            of <span class="hl-3">Media</span> and <span class="hl-2">Healthcare</span>.
          </p>
          <p data-reveal>
            I was a <span class="hl-1">Teaching Assistant</span> for UIC's Data Structures class, 
            and served as SparkHacks' 2026 <span class="hl-3">Web Development Team Lead</span>, 
            leading the design and development of the hackathon's website and dashboard system.
            I have 3 previous internships as a Software Developer, ranging from incubator programs
            to building on existing products that are used by millions of users.
          </p>
          <p data-reveal>
            I'm passionate about <span class="hl-1">Software Engineering</span>,
            <span class="hl-2">AI</span>, and <span class="hl-3">Full-stack/Web Development</span>. I
            want to use technology to create meaningful impact, whether by building personal projects,
            contributing to causes and communities, or leveraging the potential of AI/ML.
          </p>
          <p data-reveal>
            I also enjoy participating in hackathons, having <span class="hl-2">3 victories</span>
            in total!
          </p>
          <p data-reveal>
            I'm always looking for opportunities where I can keep growing my skills and making positive impact.
            If you have anything in mind, I would love to hear from you through my email or <span class="hl-3">LinkedIn</span>!
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Photo strip -->
    <section class="sec sec-full">
      <div class="photos" data-tilt>
        {
          photos.map((photo) => (
            <figure
              class="photo"
              data-reveal
              style={`--accent: ${photo.accent}; --span: ${photo.span};`}
            >
              <img src={photo.img} alt={photo.caption} loading="lazy" />
              <div class="photo-scrim" />
              <figcaption>
                <span class="dot" />
                {photo.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- 4. Stack -->
    <section class="sec">
      <div class="sec-index">02 / skills</div>
      <div class="sec-body">
        <h2 class="sec-title" data-reveal>What I use</h2>
        <h3 class="sec-note" data-reveal>Play around with the words!</h3>
        <WordCloud />
      </div>
    </section>

    <!-- 5. Go on -->
    <section class="sec">
      <div class="sec-index">03 / discover more</div>
      <div class="sec-body">
        <div class="rows">
          {
            rows.map((row) => (
              <a class="row" href={row.href} data-reveal style={`--accent: ${row.accent};`}>
                <span class="row-label">{row.label}</span>
                <span class="row-note">{row.note}</span>
                <span class="row-arrow">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

  </main>
</DesignLayout>

<style is:global>
  /* No page-level surface or ink here: this page takes `--bg` and the ink ramp
     from `global.css` so it matches Projects / Experience / Leadership. */

  /* No blanket link colour: every link on this page carries a class that
     colours it (`.cta`, `.row`, the nav, the footer), and a page-level `a`
     rule outranks all of them — which is what turned the whole page blue. */
  .design-page.home a {
    text-decoration: none;
  }

  /* The marquee used to sit between the last section and the footer. */
  .design-page.home .site-footer {
    margin-top: 110px;
  }

  /* Over the hero the wordmark would just repeat the giant name below it, so
     it stays out of the way until the hero has scrolled past. `visibility`
     also keeps it out of the tab order while it's invisible. */
  .design-page.home .wordmark {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity .45s ease, transform .45s var(--ease-out-soft),
      visibility .45s;
  }

  .design-page.home.is-past-hero .wordmark {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .design-page.home .wordmark {
      transform: none;
      transition: opacity .45s ease, visibility .45s;
    }
  }
</style>

<style>
  /* Surfaces, ink, type and the categorical trio all come from the design
     tokens in `global.css`. This page owns no colour literals. */

  /* The opacity + transition live in `global.css`; each page supplies the
     distance it travels. */
  [data-reveal] {
    transform: translateY(30px);
  }

  [data-reveal].is-revealed {
    transform: none;
  }

  /* --- shared section grid ---------------------------------------------- */

  .sec {
    max-width: 1500px;
    margin: 0 auto;
    padding: 110px 32px 0;
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 48px;
  }

  .sec-full {
    display: block;
  }

  /* Same face, size and tracking as the shared `.label-xs`. */
  .sec-index {
    position: sticky;
    top: 96px;
    align-self: start;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-5);
  }

  .sec-body {
    min-width: 0;
  }

  /* Matches `.d-title`, the display face the other pages set their headings in. */
  .sec-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 4.4vw, 62px);
    letter-spacing: 0;
    line-height: 1.15;
    margin: 0;
  }

  .sec-note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-5);
    margin: 14px 0 40px;
  }

  /* --- 1. hero ------------------------------------------------------------ */

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 32px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: -8% 0;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 12, .5) 0%,
      rgba(11, 11, 12, .35) 45%,
      var(--bg) 99%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    text-align: center;
    will-change: transform, opacity;
  }

  /* The hero introduces itself one line at a time. `backwards` holds the
     from-state through the delay so nothing flashes on screen before its
     turn. Gated on the class the inline script sets, so the stagger plays on
     arrival but not when the nav brings you back here. */
  :global(html.play-hero-intro) .hero-name,
  :global(html.play-hero-intro) .hero-sub,
  :global(html.play-hero-intro) .hero-cta {
    animation: hero-in 2s var(--ease-out-soft) backwards;
  }

  /* The delays have to live on the gated selector too. As bare `.hero-name`
     rules they lost to the shorthand above, which resets `animation-delay` to
     zero and outranks them — every line then faded in at once. */
  :global(html.play-hero-intro) .hero-name { animation-delay: 0.8s; }
  :global(html.play-hero-intro) .hero-sub { animation-delay: 2s; }
  :global(html.play-hero-intro) .hero-cta { animation-delay: 3.5s; }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .hero-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(66px, 12vw, 200px);
    line-height: 1.02;
    letter-spacing: -.01em;
    white-space: nowrap;
    margin: 0 0 22px;
  }

  .hero-sub {
    margin: 0 auto 36px;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.35;
    color: var(--ink-2);
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .cta {
    padding: 14px 26px;
    border-radius: 999px;
    line-height: 1;
    transition: transform .25s var(--ease-out-soft), background .25s ease, color .25s ease;
  }

  .cta:hover {
    transform: translateY(-2px);
  }

  .cta-primary,
  .cta-primary:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .cta-ghost,
  .cta-ghost:hover {
    border: 1px solid rgba(var(--ink-rgb), .28);
    backdrop-filter: blur(8px);
    color: var(--ink);
  }

  .scroll-cue {
    position: absolute;
    left: 32px;
    bottom: 34px;
    z-index: 1;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-4);
    animation: cue-bob 2.2s ease-in-out infinite;
  }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); opacity: .45; }
    50% { transform: translateY(9px); opacity: 1; }
  }

  /* --- 2. about ----------------------------------------------------------- */

  .about {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 62ch;
  }

  .about p {
    margin: 0;
    font-size: 19px;
    line-height: 1.62;
    color: var(--ink);
    text-wrap: pretty;
  }

  .about .about-lead {
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.35;
    color: var(--ink);
  }

  /* Emphasis spans. The hue carries no meaning — it's rhythm, spread across
     the trio so no two highlights in a paragraph share a colour. */
  .hl-1,
  .hl-2,
  .hl-3 {
    font-weight: 600;
  }

  .hl-1 { color: var(--cat-1); }
  .hl-2 { color: var(--cat-2); }
  .hl-3 { color: var(--cat-3); }

  /* --- 3. photo strip ------------------------------------------------------ */

  .photos {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px;
  }

  .photo {
    position: relative;
    grid-column: span var(--span);
    height: 400px;
    margin: 0;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--rule-soft);
    transform-style: preserve-3d;
    transition:
      border-color .35s ease,
      opacity .8s var(--ease-out-soft),
      transform .8s var(--ease-out-soft);
  }

  .photo:hover {
    border-color: var(--accent);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .6s var(--ease-out-soft);
  }

  .photo:hover img {
    transform: scale(1.05);
  }

  .photo-scrim {
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(11, 11, 12, .88), transparent);
    pointer-events: none;
  }

  .photo figcaption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink);
  }

  .photo .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* Tilt is applied to an inner transform so the reveal transition can own
     `transform` until the card is visible. */
  .photo.is-tilting {
    transition: border-color .35s ease, transform .2s ease-out;
  }

  /* --- 5. go on ------------------------------------------------------------ */

  .rows {
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 54px;
    align-items: center;
    gap: 24px;
    padding: 30px 0;
    color: var(--ink);
    transition:
      background .35s ease,
      padding-left .35s ease,
      opacity .8s var(--ease-out-soft),
      transform .8s var(--ease-out-soft);
  }

  .row + .row {
    border-top: 1px solid var(--rule);
  }

  .row:hover {
    background: rgba(var(--ink-rgb), .04);
    padding-left: 18px;
    color: var(--ink);
  }

  .row-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 44px);
    letter-spacing: 0;
    line-height: 1.15;
  }

  .row-note {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-arrow {
    justify-self: end;
    font-size: 22px;
    color: var(--accent);
  }

  /* --- responsive ---------------------------------------------------------- */

  @media (max-width: 900px) {
    .sec {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding-top: 88px;
    }

    .sec-index {
      position: static;
    }

    .photos {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo {
      grid-column: 1 / -1;
      height: clamp(240px, 46vw, 320px);
    }

    .row {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 8px 16px;
    }

    .row-label {
      grid-column: 1;
    }

    .row-note {
      grid-column: 1;
    }

    .row-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 640px) {
    .sec {
      padding-left: 20px;
      padding-right: 20px;
    }

    .hero {
      padding-left: 20px;
      padding-right: 20px;
    }

    .scroll-cue {
      left: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg,
    .hero-inner {
      transform: none !important;
    }

    .scroll-cue {
      animation: none;
      opacity: .8;
    }

    /* Keep the staggered entrance, but as a plain fade with no travel. */
    .hero-name,
    .hero-sub,
    .hero-cta {
      animation-name: hero-in-fade;
    }

    @keyframes hero-in-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }
</style>

<script>
  import { onScrollFrame, makeRevealSweep, prefersReducedMotion } from '../lib/scroll';

  const reduced = prefersReducedMotion();
  const heroBg = document.querySelector<HTMLElement>('[data-hero-bg]');
  const heroInner = document.querySelector<HTMLElement>('[data-hero-inner]');
  const reveal = makeRevealSweep(0.92);

  // One rAF-throttled handler drives the hero parallax, the hero fade and the
  // reveal sweep so they all land in the same frame.
  onScrollFrame(() => {
    const y = window.scrollY;

    if (!reduced) {
      if (heroBg) heroBg.style.transform = `translate3d(0, ${y * 0.28}px, 0)`;
      if (heroInner) heroInner.style.transform = `translate3d(0, ${y * -0.12}px, 0)`;
    }

    if (heroInner) {
      heroInner.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.8)));
    }

    // The wordmark takes over once the hero name has faded out, so the name
    // only ever reads in one place at a time.
    document.body.classList.toggle('is-past-hero', y > window.innerHeight * 0.75);

    reveal();
  });

  // Pointer tilt on the photo cards — opt-in per grid, and never under
  // reduced motion.
  const TILT = true;
  const grid = document.querySelector<HTMLElement>('[data-tilt]');

  if (TILT && grid && !reduced && window.matchMedia('(pointer: fine)').matches) {
    grid.querySelectorAll<HTMLElement>('.photo').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        const px = (event.clientX - box.left) / box.width - 0.5;
        const py = (event.clientY - box.top) / box.height - 0.5;
        card.classList.add('is-tilting');
        card.style.transform = `perspective(900px) rotateY(${px * 8}deg) rotateX(${-py * 8}deg)`;
      });

      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
        card.classList.remove('is-tilting');
      });
    });
  }
</script>
