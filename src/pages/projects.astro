---
import DesignLayout from '../layouts/DesignLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import { PROJECTS, PROJECT_KINDS } from '../data/portfolio';
import { waterfall, uniqueTags } from '../lib/waterfall';

// The unfiltered cascade is resolved at build time so the first paint already
// has its final geometry — the client only re-flows when a filter changes.
const slots = waterfall(PROJECTS.length);

// One pill per project kind, in PROJECT_KINDS order; kinds nothing is tagged
// with are dropped so the row never offers a filter that empties the grid.
const filters = [
  { name: 'all', count: PROJECTS.length },
  ...PROJECT_KINDS.map((kind) => ({
    name: kind,
    count: PROJECTS.filter((project) => project.kind === kind).length,
  })).filter((filter) => filter.count > 0),
];

// Duplicated so the translateX(-50%) loop is seamless.
const marqueeRun = uniqueTags(PROJECTS);
const marquee = [...marqueeRun, ...marqueeRun];

const stats = [
  { figure: '11', label: 'shipped', accent: false },
  { figure: '3', label: 'hackathon wins', accent: false },
  { figure: '700+', label: 'real users', accent: true },
];
---

<DesignLayout
  title="Nathan Trinh"
  description="Projects Nathan Trinh has designed, built and shipped."
  active="projects"
>
  <header class="shell hero">
    <div class="hero-row">
      <h1 class="d-h1 hero-title" data-hero>My<br /><span class="dot">shipped projects</span></h1>
      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              <div class:list={['num', 'figure', { 'is-accent': stat.accent }]}>{stat.figure}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </header>

  <div class="shell filters">
    <span class="filters-label">filter</span>
    <div class="filter-pills" role="group" aria-label="Filter projects by type">
      {
        filters.map(({ name, count }) => (
          <button
            class:list={['pill', { 'is-active': name === 'all' }]}
            type="button"
            data-filter={name}
            aria-pressed={name === 'all'}
          >
            {name}
            <span class="pill-count">{count}</span>
          </button>
        ))
      }
    </div>
    <span class="count" data-count aria-live="polite">{PROJECTS.length} / {PROJECTS.length}</span>
  </div>

  <main class="shell grid" data-grid>
    {
      PROJECTS.map((project, i) => (
        <ProjectCard project={project} index={i} tier={slots[i].tier} span={slots[i].span} />
      ))
    }
  </main>

  <ProjectDetail projects={PROJECTS} />
</DesignLayout>

<style>
  /* --- Header ------------------------------------------------------------- */

  .hero {
    padding: 84px 40px 40px;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(56px, 10vw, 170px);
  }

  .dot {
    color: var(--accent);
  }

  .stats {
    display: flex;
    gap: 44px;
    padding-bottom: 14px;
    flex-wrap: wrap;
  }

  .figure {
    font-size: 56px;
    color: var(--ink);
  }

  .figure.is-accent {
    color: var(--accent);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink-4);
    margin-top: 6px;
  }

  /* --- Marquee ------------------------------------------------------------ */

  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--rule-faint);
    border-bottom: 1px solid var(--rule-faint);
    padding: 13px 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: d-marquee 38s linear infinite;
  }

  .marquee-item {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-5);
    padding: 0 22px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  /* --- Filter row --------------------------------------------------------- */

  .filters {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 26px 40px 0;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .filters-label,
  .count {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--ink-5);
  }

  .filters-label {
    font-size: 11px;
  }

  .count {
    margin-left: auto;
  }

  .filter-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill {
    font-family: var(--font-body);
    font-size: 12px;
    cursor: pointer;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(var(--ink-rgb), .16);
    background: transparent;
    color: var(--ink-4);
    transition: color .2s ease, background .2s ease, border-color .2s ease;
  }

  .pill-count {
    margin-left: 7px;
    font-size: 10px;
    opacity: .55;
  }

  .pill:hover {
    color: var(--ink);
  }

  .pill.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  /* --- Grid --------------------------------------------------------------- */

  .grid {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 26px 40px 120px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 56px 20px 32px;
    }

    .filters {
      padding: 22px 20px 0;
    }

    .grid {
      padding: 22px 20px 80px;
    }
  }

  @media (max-width: 700px) {
    .stats {
      gap: 28px;
    }

    .figure {
      font-size: 42px;
    }
  }
</style>

<script>
  import { onScrollFrame, makeRevealSweep, parallaxHero } from '../lib/scroll';
  import { waterfall } from '../lib/waterfall';

  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const countEl = document.querySelector<HTMLElement>('[data-count]');

  /* --- Scroll: hero parallax + reveal sweep ------------------------------ */

  const heroFrame = parallaxHero(document.querySelector<HTMLElement>('[data-hero]'), -0.13);
  const sweep = makeRevealSweep(0.94);

  onScrollFrame(() => {
    heroFrame();
    sweep();
  });

  /* --- Filtering: re-apply the cascade to the filtered set --------------- */

  function applyFilter(active: string) {
    const visible = cards.filter((card) => active === 'all' || card.dataset.kind === active);
    const shown = new Set(visible);

    for (const card of cards) card.hidden = !shown.has(card);

    const slots = waterfall(visible.length);
    visible.forEach((card, i) => {
      const { tier, span } = slots[i];
      card.dataset.tier = String(tier);
      card.style.setProperty('--span', String(span));

      const badge = card.querySelector<HTMLElement>('[data-badge-text]');
    });

    if (countEl) countEl.textContent = `${visible.length} / ${cards.length}`;

    for (const pill of pills) {
      const isActive = pill.dataset.filter === active;
      pill.classList.toggle('is-active', isActive);
      pill.setAttribute('aria-pressed', String(isActive));
    }

    // Newly-shown cards further down the page still need revealing.
    sweep();
  }

  for (const pill of pills) {
    pill.addEventListener('click', () => applyFilter(pill.dataset.filter ?? 'all'));
  }

  /* --- Detail overlay ---------------------------------------------------- */

  const backdrop = document.querySelector<HTMLElement>('[data-detail-backdrop]');
  const panels = [...document.querySelectorAll<HTMLElement>('[data-detail-panel]')];
  let lastFocused: HTMLElement | null = null;

  function openDetail(index: number) {
    if (!backdrop) return;
    lastFocused = document.activeElement as HTMLElement | null;

    for (const panel of panels) panel.hidden = panel.dataset.detailPanel !== String(index);
    backdrop.hidden = false;
    document.documentElement.classList.add('scroll-locked');

    const active = panels.find((panel) => !panel.hidden);
    active?.querySelector<HTMLElement>('[data-detail-close]')?.focus();
  }

  function closeDetail() {
    if (!backdrop || backdrop.hidden) return;
    backdrop.hidden = true;
    for (const panel of panels) panel.hidden = true;
    document.documentElement.classList.remove('scroll-locked');
    lastFocused?.focus();
  }

  for (const card of cards) {
    card.querySelector('[data-open]')?.addEventListener('click', () => {
      openDetail(Number(card.dataset.index));
    });
  }

  backdrop?.addEventListener('click', (event) => {
    if (event.target === backdrop) closeDetail();
  });

  for (const button of document.querySelectorAll('[data-detail-close]')) {
    button.addEventListener('click', closeDetail);
  }

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDetail();
  });
</script>
