---
import DesignLayout from '../layouts/DesignLayout.astro';
import LeadershipSection from '../components/LeadershipSection.astro';
import { LEADERSHIP } from '../data/portfolio';
---

<DesignLayout
  title="Nathan Trinh"
  description="Teams and student organizations Nathan Trinh has helped lead."
  active="leadership"
>
  <header class="shell hero">
    <div class="hero-row">
      <h1 class="d-h1 hero-title" data-hero>My<br /><em>leadership roles</em></h1>
    </div>
    <div class="meta">
      <span>The 3 teams I helped lead throughout my time at UIC</span>
    </div>
  </header>

  <main class="shell orgs">
    {LEADERSHIP.map((entry, i) => <LeadershipSection entry={entry} index={i} />)}
  </main>
</DesignLayout>

<style>
  .hero {
    padding: 120px 40px 64px;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .hero-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(60px, 11vw, 170px);
  }

  .hero-title em {
    color: var(--accent);
  }

  .meta {
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .orgs {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 40px 120px;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 72px 20px 40px;
    }

    .orgs {
      padding: 0 20px 80px;
    }
  }
</style>

<script>
  import {
    onScrollFrame,
    makeRevealSweep,
    parallaxHero,
    countUp,
    prefersReducedMotion,
  } from '../lib/scroll';

  const heroFrame = parallaxHero(document.querySelector<HTMLElement>('[data-hero]'), -0.16);

  // Impact counters run once, when their section reveals.
  const sweep = makeRevealSweep(0.92, (section) => {
    for (const figure of section.querySelectorAll<HTMLElement>('[data-count-target]')) {
      countUp(figure);
    }
  });

  const frames = prefersReducedMotion()
    ? []
    : [...document.querySelectorAll<HTMLElement>('[data-parallax]')];

  onScrollFrame(() => {
    heroFrame();

    // Photos drift with the frame's distance from the viewport centre.
    const vh = window.innerHeight;
    for (const frame of frames) {
      const rect = frame.getBoundingClientRect();
      if (rect.bottom < -200 || rect.top > vh + 200) continue;
      const p = (rect.top + rect.height / 2 - vh / 2) / vh;
      const img = frame.querySelector<HTMLElement>('img');
      if (img) img.style.transform = `translate3d(0, ${(p * 7).toFixed(2)}%, 0)`;
    }

    sweep();
  });
</script>
